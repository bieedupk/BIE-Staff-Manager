NEXT_PUBLIC_SUPABASE_URL=

# Use either the Supabase publishable key (new) or anon key (legacy).
# This variable is safe for browser/client usage because it starts with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use either the Supabase secret key (new) or service_role key (legacy).
# Never expose this value in frontend/browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only email sending via Resend.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=

# Web Push: generate one VAPID key pair. Public key is safe for browser use.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# A separate random secret; configure the same value as the Supabase
# notifications INSERT webhook's x-bie-push-secret HTTP header.
PUSH_WEBHOOK_SECRET=

# Server-only AI welcome email generation via OpenAI.
OPENAI_API_KEY=
OPENAI_WELCOME_EMAIL_MODEL=gpt-4o-mini

# Provider selection for AI model. Supported values: gemini, openai
# Default in this project: gemini
AI_PROVIDER=gemini

# Google Gemini (using OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_WELCOME_EMAIL_MODEL=gemini-3.6-flash

# Temporary testing override: when set, all welcome emails will be delivered to this address.
# Use only for local testing. Leave empty in production.
WELCOME_EMAIL_TEST_RECIPIENT=

# Development-only Daily Reports test reset. Leave false in production.
ENABLE_TEST_RESET=false

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=BIE Super Admin
