NEXT_PUBLIC_SUPABASE_URL=

# Use either the Supabase publishable key (new) or anon key (legacy).
# This variable is safe for browser/client usage because it starts with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use either the Supabase secret key (new) or service_role key (legacy).
# Never expose this value in frontend/browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Development-only Daily Reports test reset. Leave false in production.
ENABLE_TEST_RESET=false

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=BIE Super Admin
